# Copy this file to .env and fill in real values. .env is never committed.

# Used by Flask to sign session cookies. Use a long random string.
SECRET_KEY=replace-with-a-long-random-string

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sales_app
DB_PASSWORD=your-mysql-password
DB_NAME=sales_inventory

# 1 shows the interactive debugger with tracebacks in the browser. Development
# only. Leave 0 (or remove) anywhere else.
FLASK_DEBUG=0
